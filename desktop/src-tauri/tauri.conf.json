{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLEANPLATE",
  "version": "1.0.0",
  "identifier": "app.cleanplate.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CLEANPLATE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#08090B",
        "theme": "Dark",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 ws://localhost:8000; img-src 'self' data: blob: http://localhost:8000; media-src 'self' blob: http://localhost:8000; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Self-hostable media restoration suite",
    "longDescription": "Eight restoration tools, one queue, running on your own machine. Remove it. Rebuild it. Ship it.",
    "resources": [],
    "copyright": "© 2026 CLEANPLATE"
  },
  "plugins": {}
}
