# CLEANPLATE environment variables (Section 13).
# Copy to `.env` and fill in. Phase 1 (Foundation) needs none of these — they
# are wired up in the phases noted below.

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database — Postgres (Phase 3) ────────────────────────────────────────────
DATABASE_URL=

# ── Cache & rate limiting — Upstash Redis (Phase 3 / 7) ──────────────────────
REDIS_URL=

# ── Storage — Cloudflare R2 (Phase 2) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_INPUTS=
R2_BUCKET_OUTPUTS=

# ── Inference — Replicate first, Modal behind the same adapter (Phase 3) ─────
REPLICATE_API_TOKEN=
INFERENCE_WEBHOOK_SECRET=

# ── Billing — Stripe (Phase 5) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ── Auth & security (Phase 5; AUTH_SECRET also signs Phase 2 presigned URLs) ──
# AUTH_SECRET: required in production. Falls back to a fixed dev value locally so
# the local storage adapter works with no configuration.
AUTH_SECRET=
# IP_HASH_SALT: salt for hashing IPs before storage (Section 14). Optional;
# defaults to AUTH_SECRET.
IP_HASH_SALT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Analytics & monitoring (Phase 7) ─────────────────────────────────────────
POSTHOG_KEY=
SENTRY_DSN=
