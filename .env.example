# CLEANPLATE environment variables (Section 13).
# Copy to `.env` and fill in. Phase 1 (Foundation) needs none of these — they
# are wired up in the phases noted below.

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database — Postgres (Phase 3) ────────────────────────────────────────────
DATABASE_URL=

# ── Cache & rate limiting — Upstash Redis (Phase 7) ──────────────────────────
# When set, API rate limiting uses Upstash (distributed); otherwise an in-memory
# limiter is used. Use the REST URL + token from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# ── Storage — Cloudflare R2 (Phase 2) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_INPUTS=
R2_BUCKET_OUTPUTS=

# ── Inference — Replicate first, Modal behind the same adapter (Phase 3) ─────
# Unset REPLICATE_API_TOKEN uses the built-in local background remover (dev).
REPLICATE_API_TOKEN=
# Model version hashes on Replicate (required to use the Replicate provider for
# each tool): CUTOUT (background removal), ERASE (LaMa-class inpainting),
# UPLIFT (Real-ESRGAN-class super-resolution).
REPLICATE_CUTOUT_VERSION=
REPLICATE_ERASE_VERSION=
REPLICATE_UPSCALE_VERSION=
INFERENCE_WEBHOOK_SECRET=

# ── Worker / jobs (Phase 3) ──────────────────────────────────────────────────
# INLINE_WORKER=false makes the Next app only enqueue jobs; run `pnpm worker`
# (workers/job-runner.ts) to process them. Unset/true processes in-process (dev).
INLINE_WORKER=
WORKER_POLL_MS=1000
# Bearer token protecting POST /api/cron/cleanup. Unset = open (dev only).
CRON_SECRET=

# ── Billing — Stripe (Phase 5) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ── Auth & security (Phase 5; AUTH_SECRET also signs Phase 2 presigned URLs) ──
# AUTH_SECRET: required in production. Signs session cookies + presigned URLs.
# Falls back to a fixed dev value locally so the app runs with no configuration.
AUTH_SECRET=
# IP_HASH_SALT: salt for hashing IPs before storage (Section 14). Optional;
# defaults to AUTH_SECRET.
IP_HASH_SALT=
# Google OAuth. When both are set, "Continue with Google" is enabled and the dev
# email login is disabled. Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DISABLE_DEV_LOGIN=true force-disables the no-IdP dev email login even when
# Google isn't configured.
DISABLE_DEV_LOGIN=

# ── Analytics & monitoring (Phase 7) ─────────────────────────────────────────
# PostHog (client). NEXT_PUBLIC_ so the browser can read it. No key = no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
# Sentry error reporting (server). No DSN = no-op. Scrubs emails + image URLs.
SENTRY_DSN=
