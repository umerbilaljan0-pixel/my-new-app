# CLEANPLATE — copy to .env and adjust. All values are optional; defaults shown.

# ---- Engine ----------------------------------------------------------------
# Where the SQLite job DB, model cache and job outputs live.
CLEANPLATE_HOME=~/.cleanplate
# Deployment flavour: "local" (SQLite, no auth) or "hosted" (Postgres + auth + Stripe).
CLEANPLATE_FLAVOUR=local
# One concurrent GPU job by contract. Raise only for CPU farms / tests.
CLEANPLATE_MAX_CONCURRENT=1
# Force a device instead of auto-detect: cuda | rocm | mps | onnx-cpu | cpu
CLEANPLATE_DEVICE=
# Half precision on CUDA.
CLEANPLATE_HALF_PRECISION=true
# Require the rights gate (ownership confirmation). Keep this on.
CLEANPLATE_RIGHTS_GATE=true
# Comma-separated CORS origins for the web app + site.
CLEANPLATE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,tauri://localhost
CLEANPLATE_HOST=0.0.0.0
CLEANPLATE_PORT=8000

# ---- Hosted flavour only ---------------------------------------------------
# Postgres (docker compose --profile hosted)
POSTGRES_USER=cleanplate
POSTGRES_PASSWORD=cleanplate
POSTGRES_DB=cleanplate
DATABASE_URL=postgresql://cleanplate:cleanplate@postgres:5432/cleanplate

# Auth (email magic link + Google) — JWT in an httpOnly cookie
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAGIC_LINK_FROM=noreply@cleanplate.app
SMTP_URL=

# Stripe (credit model: 1 credit = 1 image or 10s of 1080p, scaling w/ resolution)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ---- Desktop ---------------------------------------------------------------
# Perpetual licence, offline-activatable, 3 machines.
CLEANPLATE_LICENSE_PUBKEY=
